# Used for caching frequently used data + publishing async background jobs (Change password on PROD)
REDIS_URL='redis://default:docker@localhost:6379/0'
# Any regular mailbox works. For Gmail: smtp.gmail.com, port 587 and an app
# password (https://myaccount.google.com/apppasswords).
# Leave SMTP_HOST empty to only print emails to the logs.
SMTP_HOST=''
SMTP_PORT='587'
SMTP_SECURE='false'
SMTP_USER=''
SMTP_PASSWORD=''
MAIL_FROM=''

# You can put anything as secrets but we recomend generating strong keys at https://tooleroid.com/jwt-secret-generator
JWT_SECRET='' # Used to sign the JWTS
COOKIE_ENCRYPTION_SECRET='' # Used to encrypt cookies

COOKIE_DOMAIN='localhost' # For signing cookies

GOOGLE_AUTH_CLIENT_ID=''
GOOGLE_AUTH_CLIENT_SECRET=''
GOOGLE_AUTH_REDIRECT_URI='http://localhost:3333/auth/google/callback'

# Cloudflare Turnstile (get keys at https://dash.cloudflare.com/?to=/:account/turnstile)
TURNSTILE_SECRET_KEY='1x0000000000000000000000000000000AA'

# Port for the API to run on
NODE_PORT=3333
FRONTEND_URL='http://localhost:3000'

# Secret used once to create the shop (POST /companies). Generate with: openssl rand -hex 32
SETUP_KEY='change-me-to-a-long-random-string-of-32-chars'

# Photos are saved on disk and served by this API under /files/
PUBLIC_API_URL='http://localhost:3333'
UPLOADS_DIR='./uploads'
UPLOAD_URL_EXPIRES_IN='600'
