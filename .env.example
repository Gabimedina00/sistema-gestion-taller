# Settings for running everything with `docker compose up -d`.
# Copy this file to `.env` and change every value marked CHANGE.

# Where people open the app and where the app reaches the API.
# On another device of the shop's network use the server PC's IP, e.g. http://192.168.0.10:3000
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3333
COOKIE_DOMAIN=localhost

# Database and cache passwords (CHANGE)
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=taller
MYSQL_USER=taller
MYSQL_PASSWORD=change-me-db
REDIS_PASSWORD=change-me-redis

# Secrets (CHANGE). Generate each one with: openssl rand -hex 32
JWT_SECRET=change-me
COOKIE_ENCRYPTION_SECRET=change-me
# Used once to create the shop (POST /companies)
SETUP_KEY=change-me-to-a-long-random-string-of-32-chars

NODE_PORT=3333

# Email for invites and password resets, sent from any regular mailbox.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, your address as SMTP_USER and an
# app password (https://myaccount.google.com/apppasswords) as SMTP_PASSWORD.
# Leave SMTP_HOST empty and emails are only printed to the logs; the app still works.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Optional "Sign in with Google". Leave as "unused" if not needed.
GOOGLE_AUTH_CLIENT_ID=unused
GOOGLE_AUTH_CLIENT_SECRET=unused
GOOGLE_AUTH_REDIRECT_URI=http://localhost:3333/auth/google/callback

# Bot check on login. This test key always passes.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Where photos are saved inside the container (kept in the "uploads" volume)
UPLOADS_DIR=/app/uploads
